{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsbMonitorRust",
  "version": "0.2.0",
  "identifier": "br.com.usbmonitorrust",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UsbMonitor Rust",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "msi"
    ]
  }
}