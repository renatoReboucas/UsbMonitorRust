{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsbMonitorRust",
  "version": "0.2.0",
  "identifier": "br.com.usbmonitorrust",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UsbMonitor Rust",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "resources": {
      "lhm/lhm-service.msi": "lhm-service.msi",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}